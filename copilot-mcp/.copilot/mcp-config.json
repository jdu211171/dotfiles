{
  "mcpServers": {
    "context7": {
      "tools": ["*"],
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {}
    },
    "playwright": {
      "tools": ["*"],
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "chrome-devtools": {
      "tools": ["*"],
      "command": "npx",
      "args": ["chrome-devtools-mcp@latest"]
    },
    "supabase": {
      "tools": ["*"],
      "command": "/bin/bash",
      "args": ["-lc", "exec \"$HOME/dotfiles/scripts/supabase-mcp-stdio.sh\""]
    },
    "backlog": {
      "tools": ["*"],
      "command": "/bin/bash",
      "args": ["-lc", "exec \"$HOME/dotfiles/scripts/backlog-mcp-stdio.sh\""]
    },
    "eraser": {
      "url": "https://app.eraser.io/api/mcp",
      "type": "http"
    }
  }
}

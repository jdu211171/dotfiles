{
  "vim": {
    "show_edit_predictions_in_normal_mode": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "outline_panel": {
    "button": false,
    "dock": "right"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right"
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "gemini": {
      "favorite_models": [
        "auto-gemini-3"
      ],
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "project_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "show_whitespaces": "none",
  "cursor_blink": false,
  "terminal": {
    "max_scroll_history_lines": 100000
  },
  "toolbar": {
    "code_actions": false
  },
  "show_edit_predictions": true,
  "relative_line_numbers": "enabled",
  "agent": {
    "tool_permissions": {
      "tools": {
        "edit_file": {
          "default": "allow"
        },
        "create_directory": {
          "default": "allow"
        }
      },
      "default": "allow"
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    },
    "dock": "left",
    "use_modifier_to_send": true,
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gemini-3.1-pro-preview"
    },
    "model_parameters": []
  },
  "base_keymap": "JetBrains",
  "vim_mode": true,
  "ui_font_size": 15,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark"
  },
  // "formatter": {
  //   "external": {
  //     "command": "node_modules/.bin/prettier",
  //     "arguments": ["--stdin-filepath", "{buffer_path}"]
  //   }
  // },
  "formatter": "prettier",
  "format_on_save": "off",
  "context_servers": {
    "prisma-mcp": {
      "enabled": false,
      "settings": {}
    },
    "mcp-server-sequential-thinking": {
      "enabled": false,
      "settings": {}
    },
    "mcp-server-github": {
      "enabled": true,
      "settings": {
        "github_personal_access_token": "${GITHUB_TOKEN}"
      }
    }
  },
  "confirm_quit": true
}

{
  "general": {
    "preferredEditor": "vscode",
    "vimMode": true,
    "previewFeatures": true,
    "enableAutoUpdate": true,
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d",
      "warningAcknowledged": true
    },
    "defaultApprovalMode": "auto_edit"
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "theme": "Atom One",
    "hideWindowTitle": true,
    "hideTips": true,
    "hideBanner": true,
    "hideFooter": true,
    "footer": {
      "hideCWD": true
    },
    "hideContextSummary": true,
    "showMemoryUsage": true
  },
  "mcpServers": {
    "atuin": {
      "command": "atuin",
      "args": ["mcp"]
    },
    "eraser": {
      "url": "https://app.eraser.io/api/mcp"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    }
  },
  "ide": {
    "hasSeenNudge": true,
    "enabled": true
  },
  "tools": {
    "useRipgrep": true
  },
  "model": {
    "name": ""
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "headroom": {
      "type": "local",
      "command": ["{env:HOME}/.local/bin/headroom", "mcp", "serve"],
      "enabled": true
    },
    "ai-sessions": {
      "type": "local",
      "command": ["{env:HOME}/.aisessions/bin/aisessions"],
      "enabled": true
    },
    "eraser": {
      "type": "remote",
      "url": "https://app.eraser.io/api/mcp"
    },
    "atuin": {
      "type": "local",
      "command": ["atuin", "mcp"],
      "enabled": true
    }
  }
}
